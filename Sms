<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Private Chat</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
        body { background: #121212; color: #fff; display: flex; justify-content: center; align-items: center; height: 100vh; }
        .card { background: #1e1e1e; padding: 20px; border-radius: 12px; width: 100%; max-width: 400px; box-shadow: 0 4px 20px rgba(0,0,0,0.5); }
        input, button, select { width: 100%; padding: 12px; margin-top: 10px; border-radius: 6px; border: none; outline: none; }
        input, select { background: #2a2a2a; color: #fff; }
        button { background: #3b82f6; color: #fff; font-weight: bold; cursor: pointer; }
        button:hover { background: #2563eb; }
        .switch-btn { background: transparent; color: #9ca3af; font-size: 14px; margin-top: 15px; cursor: pointer; border: none; }
        .switch-btn:hover { color: #fff; text-decoration: underline; }
        #chat-box { height: 260px; overflow-y: auto; background: #141414; padding: 10px; border-radius: 6px; margin-bottom: 10px; display: flex; flex-direction: column; gap: 8px; }
        .msg { background: #2a2a2a; padding: 8px 12px; border-radius: 8px; max-width: 80%; word-break: break-word; }
        .msg.my { background: #1d4ed8; align-self: flex-end; }
        .hidden { display: none; }
        h2 { margin-bottom: 15px; font-size: 22px; text-align: center; }
        .user-info { font-size: 13px; color: #9ca3af; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
    </style>
</head>
<body>

    <!-- ЭКРАН ВХОДА -->
    <div id="login-screen" class="card">
        <h2>Вход</h2>
        <input type="text" id="login-user" placeholder="Никнейм">
        <input type="password" id="login-pass" placeholder="Пароль">
        <button onclick="loginUser()">Войти</button>
        <button class="switch-btn" onclick="showScreen('register-screen')">Нет аккаунта? Зарегистрироваться</button>
    </div>

    <!-- ЭКРАН РЕГИСТРАЦИИ -->
    <div id="register-screen" class="card hidden">
        <h2>Регистрация</h2>
        <input type="text" id="reg-user" placeholder="Придумай никнейм">
        <input type="password" id="reg-pass" placeholder="Придумай пароль">
        <button onclick="registerUser()">Создать аккаунт</button>
        <button class="switch-btn" onclick="showScreen('login-screen')">Уже есть аккаунт? Войти</button>
    </div>

    <!-- ЭКРАН ВЫБОРА КОНТАКТА -->
    <div id="contacts-screen" class="card hidden">
        <h2>Выбор контакта</h2>
        <div class="user-info">
            <span id="current-username-display"></span>
            <button onclick="logout()" style="width: auto; padding: 5px 10px; font-size: 12px; background: #ef4444; margin:0;">Выйти</button>
        </div>
        <select id="user-list">
            <option value="" disabled selected>Загрузка пользователей...</option>
        </select>
        <button onclick="startChat()">Открыть чат</button>
    </div>

    <!-- ЭКРАН ЧАТА -->
    <div id="chat-screen" class="card hidden">
        <div class="user-info">
            <span id="chat-with-display"></span>
            <button onclick="backToContacts()" style="width: auto; padding: 5px 10px; font-size: 12px; background: #4b5563; margin:0;">Назад</button>
        </div>
        <div id="chat-box"></div>
        <div style="display: flex; gap: 8px;">
            <input type="text" id="message-input" placeholder="Сообщение..." onkeypress="if(event.key==='Enter') sendMsg()">
            <button onclick="sendMsg()" style="width: auto; margin: 0;">➔</button>
        </div>
    </div>

    <!-- Firebase SDK (v10) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getDatabase, ref, set, get, child, push, onChildAdded } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

        const firebaseConfig = {
            apiKey: "AIzaSyCthxgtCeb1IE8zyDtZbxSiaIfB7O6gy88",
            authDomain: "leloid.firebaseapp.com",
            projectId: "leloid",
            storageBucket: "leloid.firebasestorage.app",
            messagingSenderId: "926100469197",
            appId: "1:926100469197:web:51936a7b85cee1d96c4084",
            measurementId: "G-YND5K5LFM1",
            databaseURL: "https://leloid-default-rtdb.firebaseio.com"
        };

        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);

        let loggedUser = null;
        let activeChatRoom = null;
        let messageListener = null;

        window.showScreen = function(screenId) {
            document.querySelectorAll('.card').forEach(c => c.classList.add('hidden'));
            document.getElementById(screenId).classList.remove('hidden');
        }

        // Регистрация
        window.registerUser = async function() {
            const user = document.getElementById("reg-user").value.trim();
            const pass = document.getElementById("reg-pass").value.trim();
            if (!user || !pass) return alert("Заполни все поля!");

            const userRef = ref(db, "users/" + user);
            const snapshot = await get(userRef);

            if (snapshot.exists()) {
                return alert("Такой ник уже занят!");
            }

            // Сохраняем пользователя и пароль в базу
            await set(userRef, { password: pass });
            alert("Регистрация успешна! Теперь войди.");
            showScreen('login-screen');
        }

        // Вход
        window.loginUser = async function() {
            const user = document.getElementById("login-user").value.trim();
            const pass = document.getElementById("login-pass").value.trim();
            if (!user || !pass) return alert("Заполни все поля!");

            const userRef = ref(db, "users/" + user);
            const snapshot = await get(userRef);

            if (!snapshot.exists() || snapshot.val().password !== pass) {
                return alert("Неверный ник или пароль!");
            }

            loggedUser = user;
            document.getElementById("current-username-display").textContent = "Ты: " + loggedUser;
            loadUsersList();
            showScreen('contacts-screen');
        }

        window.logout = function() {
            loggedUser = null;
            showScreen('login-screen');
        }

        // Загрузка списка других пользователей для выбора контакта
        async function loadUsersList() {
            const select = document.getElementById("user-list");
            select.innerHTML = '<option value="" disabled selected>Выбери собеседника</option>';

            const usersRef = ref(db, "users");
            const snapshot = await get(usersRef);

            if (snapshot.exists()) {
                snapshot.forEach((childSnapshot) => {
                    const username = childSnapshot.key;
                    if (username !== loggedUser) {
                        const opt = document.createElement("option");
                        opt.value = username;
                        opt.textContent = username;
                        select.appendChild(opt);
                    }
                });
            }
        }

        // Открытие чата с выбранным контактом
        window.startChat = function() {
            const targetUser = document.getElementById("user-list").value;
            if (!targetUser) return alert("Выбери собеседника!");

            // Создаем уникальный ID комнаты для двоих (сортируем имена по алфавиту, чтобы комната была одна на двоих)
            activeChatRoom = [loggedUser, targetUser].sort().join("_");

            document.getElementById("chat-with-display").textContent = "Чат с: " + targetUser;
            document.getElementById("chat-box").innerHTML = "";
            showScreen('chat-screen');

            // Слушаем сообщения именно для этой пары
            const chatRef = ref(db, "chats/" + activeChatRoom);
            onChildAdded(chatRef, (snapshot) => {
                const data = snapshot.val();
                renderMessage(data.user, data.text);
            });
        }

        window.backToContacts = function() {
            showScreen('contacts-screen');
        }

        window.sendMsg = function() {
            const input = document.getElementById("message-input");
            const text = input.value.trim();
            if (!text) return;

            const chatRef = ref(db, "chats/" + activeChatRoom);
            push(chatRef, {
                user: loggedUser,
                text: text,
                time: Date.now()
            });

            input.value = "";
        }

        function renderMessage(user, text) {
            const box = document.getElementById("chat-box");
            const div = document.createElement("div");
            div.classList.add("msg");
            if (user === loggedUser) div.classList.add("my");
            div.textContent = `${user}: ${text}`;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }
    </script>
</body>
</html>
